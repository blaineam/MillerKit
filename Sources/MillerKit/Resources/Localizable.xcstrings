    "No accounts, no tracking, no ads — nothing you do in %@ is sent anywhere unless you send it yourself.": {
      "comment": "Footer under the About rows; parameter is the app name",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账户，没有追踪，没有广告——你在 %@ 里做的任何事都不会被发送到任何地方，除非你自己发送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントも、トラッキングも、広告もありません。%@ でのあなたの操作は、自分から送らない限り、どこにも送信されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Accounts, kein Tracking, keine Werbung – nichts, was du in %@ tust, wird irgendwohin gesendet, außer du sendest es selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte, aucun suivi, aucune publicité — rien de ce que vous faites dans %@ n'est envoyé où que ce soit, sauf si vous l'envoyez vous-même."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuentas, sin seguimiento, sin anuncios: nada de lo que hagas en %@ se envía a ningún sitio a menos que lo envíes tú."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도, 추적도, 광고도 없습니다 — %@에서 하는 어떤 것도 직접 보내지 않는 한 어디로도 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem contas, sem rastreamento, sem anúncios — nada do que você faz no %@ é enviado para lugar nenhum, a não ser que você mesmo envie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessun tracciamento, nessuna pubblicità: niente di ciò che fai in %@ viene inviato da nessuna parte, a meno che non lo invii tu."
          }
        }
      }
    },

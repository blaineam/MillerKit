    "My Other Apps": {
      "comment": "Button that opens the developer's app portfolio",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine anderen Apps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis otras apps"
          }
        },
        "fr": {
